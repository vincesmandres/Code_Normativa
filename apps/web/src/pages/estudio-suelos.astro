---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Creacion y control de reportes geotecnicos conforme a la NEC-SE-GC." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chango&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>CodeNormative | Reportes geotecnicos</title>
  </head>
  <body>
    <main class="app-shell">
      <aside class="sidebar soil-sidebar" aria-label="Datos geotecnicos">
        <div class="brand"><span class="brand-mark">C/N</span><div><p>CodeNormative</p><span>Geotecnia · NEC-SE-GC</span></div></div>
        <nav class="module-nav" aria-label="Modulos de CodeNormative">
          <a href="/"><span>01</span> Creador de espectro</a>
          <a href="/estudio-suelos" class="active"><span>02</span> Reportes geotecnicos</a>
        </nav>
        <form id="soil-form" class="form-grid review-form">
          <div class="numeric-row">
            <label>Niveles<input name="floors" type="number" min="1" step="1" value="4" /></label>
            <label>Carga max. columna (kN)<input name="columnLoad" type="number" min="1" step="1" value="1200" /></label>
          </div>
          <label>Tipo de cimentacion
            <select name="foundation">
              <option value="footing">Zapata superficial</option>
              <option value="raft">Losa de cimentacion</option>
              <option value="pile">Pilote individual</option>
              <option value="pile-group">Grupo de pilotes</option>
              <option value="excavation">Excavacion / subsuelo</option>
            </select>
          </label>
          <div class="numeric-row">
            <label>Ancho B (m)<input name="width" type="number" min="0.1" step="0.1" value="2" /></label>
            <label>Longitud pilote / excavacion (m)<input name="length" type="number" min="0" step="0.1" value="10" /></label>
          </div>
          <div class="numeric-row">
            <label>Diametro pilote (m)<input name="diameter" type="number" min="0.1" step="0.1" value="0.5" /></label>
            <label>Ancho grupo/cabezal (m)<input name="groupWidth" type="number" min="0.1" step="0.1" value="3" /></label>
          </div>
          <div class="numeric-row">
            <label>Sondeos ejecutados<input name="actualBorings" type="number" min="0" step="1" value="4" /></label>
            <label>Profundidad alcanzada (m)<input name="actualDepth" type="number" min="0" step="0.5" value="15" /></label>
          </div>
          <label>Vs30 (m/s)<input name="vs30" type="number" min="0" step="1" value="320" /></label>
          <div class="numeric-row">
            <label>Carga servicio (kN)<input name="serviceLoad" type="number" min="0" step="1" value="900" /></label>
            <label>Area cimentacion (m²)<input name="area" type="number" min="0.01" step="0.1" value="4" /></label>
          </div>
          <div class="numeric-row">
            <label>qu neta (kPa)<input name="qunet" type="number" min="0" step="1" value="750" /></label>
            <label>q sobrecarga retirada (kPa)<input name="qob" type="number" min="0" step="1" value="0" /></label>
          </div>
          <label>Combinacion para capacidad
            <select name="loadCase"><option value="normal">D + L normal · FS 3.0</option><option value="maximum">D + L maxima · FS 2.5</option><option value="seismic">D + L + sismo · FS 1.5</option></select>
          </label>
          <div class="numeric-row">
            <label>Asentamiento estimado (mm)<input name="settlement" type="number" min="0" step="1" value="18" /></label>
            <label>Limite del proyecto (mm)<input name="settlementLimit" type="number" min="0" step="1" value="25" /></label>
          </div>
          <button type="submit" class="calculate-button">Evaluar estudio <span>↗</span></button>
        </form>
      </aside>

      <section class="workspace soil-workspace">
        <header class="topbar"><div><p class="eyebrow">NEC-15 / NEC-SE-GC</p><h1>Reportes geotecnicos</h1></div><div class="status-pill" id="soil-status">Por evaluar</div></header>
        <p class="review-notice">Predimensionamiento y control de completitud. La clasificación final del perfil, los parámetros resistentes y las recomendaciones de cimentación corresponden al ingeniero geotécnico responsable.</p>

        <section class="result-window boring-data-panel">
          <div class="window-bar"><span class="window-index">01</span><div><h2>Datos base de la perforacion</h2><p>Identificacion, localizacion y condiciones de ejecución</p></div></div>
          <div class="boring-base-grid">
            <label>Proyecto<input name="projectName" form="soil-form" value="Edificio residencial" /></label>
            <label>Cliente<input name="client" form="soil-form" value="Propietario" /></label>
            <label>Ubicacion<input name="location" form="soil-form" placeholder="Ciudad, parroquia, direccion" /></label>
            <label>Perforacion<input name="boringId" form="soil-form" value="S-01" /></label>
            <label>Coordenada Este<input name="coordE" form="soil-form" placeholder="m E" /></label>
            <label>Coordenada Norte<input name="coordN" form="soil-form" placeholder="m N" /></label>
            <label>Cota terreno (m)<input name="elevation" form="soil-form" type="number" step="0.01" value="0" /></label>
            <label>Fecha<input name="boringDate" form="soil-form" type="date" /></label>
            <label>Metodo<select name="method" form="soil-form"><option>SPT con perforacion a percusion</option><option>Rotacion con recuperacion de nucleo</option><option>CPT / CPTu</option><option>Calicata</option></select></label>
            <label>Perforista / laboratorio<input name="operator" form="soil-form" placeholder="Empresa o responsable" /></label>
            <label>Nivel freatico (m)<input name="waterDepth" form="soil-form" type="number" min="0" step="0.1" placeholder="No observado" /></label>
            <label>Profundidad final (m)<input name="boringFinalDepth" form="soil-form" type="number" min="0.1" step="0.1" value="6" /></label>
          </div>
        </section>

        <section class="result-window boring-log-panel">
          <div class="window-bar boring-log-bar"><span class="window-index">02</span><div><h2>Registro estratigrafico y SPT</h2><p>N-SPT = segundo tramo + tercer tramo de penetracion</p></div><div class="actions"><button type="button" id="add-layer" class="secondary">+ Estrato</button><button type="button" id="save-boring" class="secondary">Guardar</button><button type="button" id="pdf-boring">Descargar PDF</button></div></div>
          <div class="integration-bar" aria-label="Interoperabilidad geotecnica">
            <div><strong>Interoperabilidad</strong><span>Formatos abiertos para continuar el modelo en software especializado.</span></div>
            <button type="button" id="export-geo5" class="secondary">GEO5 · CSV</button>
            <button type="button" id="export-geostudio" class="secondary">GeoStudio · CSV</button>
            <button type="button" id="export-dxf" class="secondary">Perfil · DXF</button>
            <button type="button" id="export-project" class="secondary">Respaldo · JSON</button>
            <label class="import-project">Importar JSON<input id="import-project" type="file" accept="application/json,.json" /></label>
          </div>
          <div class="boring-editor">
            <div id="bore-profile" class="bore-profile" aria-label="Columna estratigrafica"></div>
            <div class="boring-table-wrap">
              <table class="boring-table">
                <thead><tr><th>Desde<br />m</th><th>Hasta<br />m</th><th>Descripcion del material</th><th>USCS</th><th>Muestra</th><th>SPT<br />0-15</th><th>SPT<br />15-30</th><th>SPT<br />30-45</th><th>N</th><th>w<br />%</th><th>γ<br />kN/m³</th><th>c′<br />kPa</th><th>φ′<br />°</th><th>k<br />m/s</th><th>E<br />MPa</th><th></th></tr></thead>
                <tbody id="layer-rows"></tbody>
              </table>
            </div>
          </div>
          <div class="boring-observations"><label>Observaciones de campo<textarea name="fieldNotes" form="soil-form" rows="3" placeholder="Perdida de circulacion, rechazo, cambios de color, olor, cementacion, nivel de agua..."></textarea></label></div>
        </section>

        <section class="result-window site-model-panel">
          <div class="window-bar boring-log-bar"><span class="window-index">03</span><div><h2>Proyecto multisondeo y modelo 3D</h2><p>Correlacion espacial conceptual; requiere validacion del geotecnico responsable</p></div><div class="actions"><button type="button" id="new-boring" class="secondary">+ Nuevo sondeo</button></div></div>
          <div class="site-model-grid"><aside><strong>Sondeos del proyecto</strong><div id="boring-list" class="boring-list"></div><p id="model-validation" class="model-validation"></p></aside><div id="site-model" class="site-model" role="img" aria-label="Modelo tridimensional conceptual del subsuelo"></div></div>
        </section>

        <section class="result-window">
          <div class="window-bar"><span class="window-index">03</span><div><h2>Alcance mínimo de exploración</h2><p>NEC-SE-GC tablas 1, 2 y 3</p></div></div>
          <div class="review-metrics soil-metrics">
            <article><span>Categoria</span><strong id="soil-category">-</strong><small id="category-basis">-</small></article>
            <article><span>Sondeos mínimos</span><strong id="required-borings">-</strong><small>Por unidad de construccion</small></article>
            <article><span>Profundidad requerida</span><strong id="required-depth">-</strong><small id="depth-basis">-</small></article>
            <article><span>Perfil preliminar</span><strong id="soil-profile">-</strong><small id="profile-basis">-</small></article>
          </div>
        </section>

        <section class="soil-grid">
          <section class="result-window capacity-panel">
            <div class="window-bar"><span class="window-index">04</span><div><h2>Capacidad y servicio</h2><p>Comparacion de presión, capacidad admisible y asentamiento</p></div></div>
            <div class="capacity-visual">
              <div class="capacity-numbers"><div><span>Presion aplicada</span><strong id="applied-pressure">-</strong></div><div><span>q admisible</span><strong id="allowable-capacity">-</strong></div><div><span>Utilizacion</span><strong id="capacity-use">-</strong></div></div>
              <div class="capacity-track" aria-label="Utilizacion de capacidad portante"><span id="capacity-bar"></span></div>
              <p id="capacity-note">Ingrese los parametros del informe geotecnico.</p>
            </div>
            <div class="soil-flags">
              <label><input type="checkbox" name="specialSoil" form="soil-form" /> Perfil especial F / relleno no controlado</label>
              <label><input type="checkbox" name="groundwater" form="soil-form" /> Nivel freatico investigado</label>
              <label><input type="checkbox" name="liquefaction" form="soil-form" /> Potencial de licuacion evaluado</label>
              <label><input type="checkbox" name="neighbors" form="soil-form" /> Efectos sobre vecinos evaluados</label>
            </div>
          </section>

          <section class="result-window findings-panel">
            <div class="window-bar"><span class="window-index">05</span><div><h2>Control del estudio</h2><p id="soil-summary">Complete los datos.</p></div></div>
            <div id="soil-findings" class="findings" aria-live="polite"></div>
          </section>
        </section>

        <section class="result-window">
          <div class="window-bar"><span class="window-index">06</span><div><h2>Contenido del informe</h2><p>Lista de entrega para revisión del expediente geotécnico</p></div></div>
          <div class="report-checklist">
            <label><input type="checkbox" name="locationPlans" form="soil-form" /> Planos de localizacion y ubicación de trabajos de campo</label>
            <label><input type="checkbox" name="logs" form="soil-form" /> Registros de perforacion y ensayos de campo/laboratorio</label>
            <label><input type="checkbox" name="profile" form="soil-form" /> Perfil geotecnico con incertidumbres identificadas</label>
            <label><input type="checkbox" name="calculations" form="soil-form" /> Memoria de calculo, metodologia, graficos y tablas</label>
            <label><input type="checkbox" name="construction" form="soil-form" /> Recomendaciones y sistema constructivo</label>
            <a href="https://www.habitatyvivienda.gob.ec/wp-content/uploads/2023/03/7.-NEC-SE-GC-Geotecnia-y-Cimentaciones.pdf" download>Descargar NEC-SE-GC PDF ↘</a>
          </div>
        </section>
      </section>
    </main>

    <script>
      import { jsPDF } from "jspdf";
      import type { Borehole } from "../lib/geotech-engine";
      import { validateBorehole } from "../lib/geotech-engine";
      import { saveModule } from "../lib/project-store";
      const form = document.querySelector<HTMLFormElement>("#soil-form")!;
      const layerRows = document.querySelector<HTMLTableSectionElement>("#layer-rows")!;
      const boreProfile = document.querySelector<HTMLElement>("#bore-profile")!;
      const n = (data: FormData, key: string) => Number(data.get(key));
      const s = (data: FormData, key: string) => String(data.get(key));
      const set = (selector: string, value: string) => { const node = document.querySelector(selector); if (node) node.textContent = value; };

      const categories = [
        { name: "Baja", borings: 3, depth: 6 },
        { name: "Media", borings: 4, depth: 15 },
        { name: "Alta", borings: 4, depth: 25 },
        { name: "Especial", borings: 5, depth: 30 },
      ];

      type Layer = { from: number; to: number; description: string; uscs: string; sample: string; n1: number; n2: number; n3: number; moisture: number; gamma: number; cohesion: number; friction: number; permeability: number; modulus: number };
      const colors: Record<string, string> = { GW: "#bca77c", GP: "#c9b58c", GM: "#ab9b78", GC: "#98896c", SW: "#dfc78f", SP: "#ead7a9", SM: "#c9ad79", SC: "#b9956c", ML: "#b9ad8d", CL: "#9fae9b", OL: "#7d8c78", MH: "#a4a0b3", CH: "#82958a", OH: "#6e7768", PT: "#4c463b" };
      let layers: Layer[] = [
        { from: 0, to: 0.5, description: "Relleno arenoso con grava", uscs: "SM", sample: "M-01", n1: 3, n2: 4, n3: 5, moisture: 12, gamma: 18, cohesion: 2, friction: 28, permeability: 1e-5, modulus: 12 },
        { from: 0.5, to: 3, description: "Arena limosa medianamente densa", uscs: "SM", sample: "SPT-01", n1: 5, n2: 7, n3: 8, moisture: 18, gamma: 18.5, cohesion: 3, friction: 30, permeability: 5e-6, modulus: 18 },
        { from: 3, to: 6, description: "Arcilla de baja plasticidad, firme", uscs: "CL", sample: "SPT-02", n1: 6, n2: 9, n3: 10, moisture: 26, gamma: 19, cohesion: 25, friction: 22, permeability: 1e-8, modulus: 15 },
      ];
      let boreholes: Borehole[] = [];
      let activeBoring = 0;

      function captureBoring(): Borehole {
        const data = new FormData(form);
        return { id: String(data.get("boringId") || `S-${String(activeBoring + 1).padStart(2,"0")}`), x: Number(data.get("coordE")) || 0, y: Number(data.get("coordN")) || 0, elevation: Number(data.get("elevation")) || 0, finalDepth: Number(data.get("boringFinalDepth")) || 1, waterDepth: data.get("waterDepth") ? Number(data.get("waterDepth")) : null, layers: structuredClone(layers) };
      }

      function syncActiveBoring() { boreholes[activeBoring] = captureBoring(); }

      function loadBoring(index: number) {
        syncActiveBoring(); activeBoring = index; const borehole = boreholes[index]; layers = structuredClone(borehole.layers);
        const values: Record<string, string|number> = { boringId: borehole.id, coordE: borehole.x, coordN: borehole.y, elevation: borehole.elevation, boringFinalDepth: borehole.finalDepth, waterDepth: borehole.waterDepth ?? "" };
        Object.entries(values).forEach(([key,value]) => { const field=form.elements.namedItem(key) as HTMLInputElement|null; if(field) field.value=String(value); });
        renderLayers(); renderBoreholeProject(); update();
      }

      function renderBoreholeProject() {
        syncActiveBoring();
        const list = document.querySelector("#boring-list")!;
        list.innerHTML = boreholes.map((borehole,index)=>`<button type="button" class="boring-chip ${index===activeBoring?"active":""}" data-boring="${index}"><strong>${escapeHtml(borehole.id)}</strong><span>E ${borehole.x.toFixed(1)} / N ${borehole.y.toFixed(1)} / ${borehole.finalDepth.toFixed(1)} m</span></button>`).join("");
        const allErrors=boreholes.flatMap(validateBorehole); set("#model-validation", allErrors.length ? `${allErrors.length} observaciones de consistencia: ${allErrors[0]}` : `${boreholes.length} sondeo(s) consistentes para correlacion conceptual.`);
        const palette=["#c9ad79","#9fae9b","#82958a","#98896c","#a4a0b3"];
        const minX=Math.min(...boreholes.map(b=>b.x)), minY=Math.min(...boreholes.map(b=>b.y));
        document.querySelector("#site-model")!.innerHTML=`<svg viewBox="0 0 760 420" aria-hidden="true"><defs><linearGradient id="ground" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#eef1eb"/><stop offset="1" stop-color="#d7ddd3"/></linearGradient></defs><path d="M80 90 L430 40 L690 135 L335 190 Z" fill="url(#ground)" stroke="#758174"/>${boreholes.map((b)=>{const x=170+(b.x-minX)*.35+(b.y-minY)*.18;const y=115-(b.y-minY)*.12;const scale=240/Math.max(...boreholes.map(q=>q.finalDepth),1);return `<g><text x="${x-15}" y="${y-10}" font-size="13" font-weight="700">${escapeHtml(b.id)}</text>${b.layers.map((l,li)=>`<path d="M${x} ${y+l.from*scale} l42 -6 v${Math.max((l.to-l.from)*scale,4)} l-42 6 z" fill="${palette[li%palette.length]}" stroke="#59635a"><title>${escapeHtml(l.uscs)} ${escapeHtml(l.description)}</title></path>`).join("")}<line x1="${x}" y1="${y}" x2="${x}" y2="${y+b.finalDepth*scale}" stroke="#26352b"/></g>`}).join("")}</svg>`;
      }

      const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[char]!);

      function renderLayers() {
        layerRows.innerHTML = layers.map((layer, index) => `<tr data-index="${index}">
          <td><input data-key="from" type="number" min="0" step="0.1" value="${layer.from}"></td>
          <td><input data-key="to" type="number" min="0" step="0.1" value="${layer.to}"></td>
          <td><input data-key="description" value="${escapeHtml(layer.description)}"></td>
          <td><select data-key="uscs">${["GW","GP","GM","GC","SW","SP","SM","SC","ML","CL","OL","MH","CH","OH","PT"].map((code) => `<option ${code === layer.uscs ? "selected" : ""}>${code}</option>`).join("")}</select></td>
          <td><input data-key="sample" value="${escapeHtml(layer.sample)}"></td>
          <td><input data-key="n1" type="number" min="0" value="${layer.n1}"></td>
          <td><input data-key="n2" type="number" min="0" value="${layer.n2}"></td>
          <td><input data-key="n3" type="number" min="0" value="${layer.n3}"></td>
          <td class="n-value">${layer.n2 + layer.n3}</td>
          <td><input data-key="moisture" type="number" min="0" step="0.1" value="${layer.moisture}"></td>
          <td><input data-key="gamma" type="number" min="0" step="0.1" value="${layer.gamma}"></td>
          <td><input data-key="cohesion" type="number" min="0" step="0.1" value="${layer.cohesion}"></td>
          <td><input data-key="friction" type="number" min="0" step="0.1" value="${layer.friction}"></td>
          <td><input data-key="permeability" type="number" min="0" step="0.00000001" value="${layer.permeability}"></td>
          <td><input data-key="modulus" type="number" min="0" step="0.1" value="${layer.modulus}"></td>
          <td><button type="button" class="remove-layer" aria-label="Eliminar estrato">×</button></td>
        </tr>`).join("");
        renderProfile();
      }

      function renderProfile() {
        const finalDepth = Math.max(Number(new FormData(form).get("boringFinalDepth")) || 1, ...layers.map((layer) => layer.to));
        boreProfile.innerHTML = `<div class="profile-scale">${Array.from({ length: Math.ceil(finalDepth) + 1 }, (_, depth) => `<span style="top:${depth / finalDepth * 100}%">${depth} m</span>`).join("")}</div><div class="profile-column">${layers.map((layer) => `<div class="profile-layer" style="top:${layer.from / finalDepth * 100}%;height:${Math.max((layer.to - layer.from) / finalDepth * 100, 2)}%;background:${colors[layer.uscs] || "#aaa"}"><strong>${escapeHtml(layer.uscs)}</strong><span>${escapeHtml(layer.description)}</span></div>`).join("")}</div>`;
      }

      function syncLayers(event: Event) {
        const target = event.target as HTMLInputElement | HTMLSelectElement;
        const row = target.closest<HTMLTableRowElement>("tr[data-index]");
        if (!row || !target.dataset.key) return;
        const index = Number(row.dataset.index);
        const key = target.dataset.key as keyof Layer;
        (layers[index] as any)[key] = ["description", "uscs", "sample"].includes(key) ? target.value : Number(target.value);
        row.querySelector(".n-value")!.textContent = String(layers[index].n2 + layers[index].n3);
        renderProfile();
      }

      const csvCell = (value: unknown) => `"${String(value ?? "").replaceAll('"', '""')}"`;
      function downloadFile(name: string, content: string, type: string) { const url = URL.createObjectURL(new Blob([content], { type })); const link = document.createElement("a"); link.href = url; link.download = name; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000); }
      function projectPayload() { return { schema: "codenormative.geotech.v1", exportedAt: new Date().toISOString(), form: Object.fromEntries(new FormData(form)), layers }; }

      function generatePdf() {
        const data = new FormData(form);
        const v = (key: string) => String(data.get(key) || "-");
        const doc = new jsPDF({ unit: "mm", format: "a4" });
        const pageWidth = doc.internal.pageSize.getWidth();
        doc.setFillColor(50, 70, 58); doc.rect(0, 0, pageWidth, 18, "F");
        doc.setTextColor(255); doc.setFont("helvetica", "bold"); doc.setFontSize(15); doc.text("REPORTE DE PERFORACION", 12, 11);
        doc.setFontSize(8); doc.text("CODENORMATIVE / NEC-SE-GC", pageWidth - 12, 10, { align: "right" });
        doc.setTextColor(30); doc.setFontSize(10); doc.text(`${v("projectName")} / ${v("boringId")}`, 12, 25);
        const meta = [["Cliente",v("client")],["Ubicacion",v("location")],["Coordenadas",`${v("coordE")} E / ${v("coordN")} N`],["Cota",`${v("elevation")} m`],["Fecha",v("boringDate")],["Metodo",v("method")],["Responsable",v("operator")],["Nivel freatico",`${v("waterDepth")} m`]];
        meta.forEach(([label,value],i) => { const x=12+(i%2)*94; const y=32+Math.floor(i/2)*10; doc.setFontSize(6.5); doc.setTextColor(100); doc.text(label.toUpperCase(),x,y); doc.setFontSize(8); doc.setTextColor(30); doc.text(doc.splitTextToSize(value,82),x,y+4); });
        let y = 76; const maxDepth = Math.max(Number(data.get("boringFinalDepth")) || 1, ...layers.map((layer) => layer.to));
        doc.setFontSize(8); doc.setFont("helvetica","bold"); doc.text("PERFIL",12,y); doc.text("REGISTRO ESTRATIGRAFICO Y ENSAYOS",60,y); y+=4;
        const profileTop=y; const profileHeight=150; doc.setDrawColor(90); doc.rect(12,profileTop,40,profileHeight);
        layers.forEach((layer) => { const top=profileTop+layer.from/maxDepth*profileHeight; const height=Math.max((layer.to-layer.from)/maxDepth*profileHeight,3); const hex=colors[layer.uscs]||"#aaaaaa"; const rgb=[parseInt(hex.slice(1,3),16),parseInt(hex.slice(3,5),16),parseInt(hex.slice(5,7),16)]; doc.setFillColor(rgb[0],rgb[1],rgb[2]); doc.rect(12,top,40,height,"FD"); doc.setFontSize(6); doc.setTextColor(25); doc.text(`${layer.from.toFixed(2)}-${layer.to.toFixed(2)} m  ${layer.uscs}`,14,top+3); if(height>8) doc.text(doc.splitTextToSize(layer.description,35).slice(0,2),14,top+6); });
        const cols=[60,73,86,100,116,132,145,158,172,188]; const heads=["Desde","Hasta","USCS","Muestra","N1","N2","N3","N-SPT","w %","gamma"];
        doc.setFillColor(232,232,232); doc.rect(58,profileTop,pageWidth-70,7,"F"); doc.setFontSize(5.7); doc.setFont("helvetica","bold"); heads.forEach((h,i)=>doc.text(h,cols[i],profileTop+4.5));
        let rowY=profileTop+12; doc.setFont("helvetica","normal");
        layers.forEach((layer) => { if(rowY>255){doc.addPage();rowY=18;} const vals=[layer.from.toFixed(2),layer.to.toFixed(2),layer.uscs,layer.sample,layer.n1,layer.n2,layer.n3,layer.n2+layer.n3,layer.moisture.toFixed(1),layer.gamma.toFixed(1)]; vals.forEach((val,i)=>doc.text(String(val),cols[i],rowY)); doc.setFontSize(6.3); doc.text(doc.splitTextToSize(layer.description,125),60,rowY+4); doc.setDrawColor(210); doc.line(58,rowY+10,pageWidth-12,rowY+10); rowY+=16; });
        if(rowY>250){doc.addPage();rowY=18;} doc.setFontSize(7); doc.setFont("helvetica","bold"); doc.text("PARAMETROS PARA MODELACION",60,rowY); rowY+=5; doc.setFont("helvetica","normal");
        layers.forEach((layer)=>{doc.text(`${layer.uscs}: gamma=${layer.gamma} kN/m3 | c'=${layer.cohesion} kPa | phi'=${layer.friction} deg | k=${layer.permeability} m/s | E=${layer.modulus} MPa`,60,rowY);rowY+=5;});
        doc.setFont("helvetica","bold"); doc.text("OBSERVACIONES",12,profileTop+profileHeight+9); doc.setFont("helvetica","normal"); doc.text(doc.splitTextToSize(v("fieldNotes"),180),12,profileTop+profileHeight+14);
        doc.setFontSize(6.5); doc.setTextColor(90); doc.text("Registro sujeto a revision y firma del ingeniero geotecnico responsable.",12,288); doc.text(`Pagina ${doc.getNumberOfPages()}`,pageWidth-12,288,{align:"right"});
        doc.save(`perforacion-${v("boringId").replace(/[^a-z0-9_-]/gi,"-")}.pdf`);
      }

      function categoryIndex(floors: number, load: number) {
        const floorIndex = floors <= 3 ? 0 : floors <= 10 ? 1 : floors <= 20 ? 2 : 3;
        const loadIndex = load <= 800 ? 0 : load <= 4000 ? 1 : load <= 8000 ? 2 : 3;
        return Math.max(floorIndex, loadIndex);
      }

      function foundationDepth(data: FormData) {
        const type = s(data, "foundation");
        const width = n(data, "width");
        const length = n(data, "length");
        const diameter = n(data, "diameter");
        const groupWidth = n(data, "groupWidth");
        if (type === "raft") return { value: 1.5 * width, label: "1.5 × ancho de losa" };
        if (type === "footing") return { value: 2.5 * width, label: "2.5 × ancho de zapata" };
        if (type === "pile") return { value: length + 4 * diameter, label: "longitud + 4 diametros" };
        if (type === "pile-group") return { value: Math.max(length + 2 * groupWidth, 2.5 * groupWidth), label: "max(L + 2B grupo, 2.5B cabezal)" };
        return { value: 1.5 * length, label: "1.5 × profundidad de excavacion" };
      }

      function profile(vs30: number, special: boolean) {
        if (special) return { name: "F", detail: "Evaluacion especifica del sitio" };
        if (vs30 >= 1500) return { name: "A", detail: "Vs30 ≥ 1500 m/s" };
        if (vs30 >= 760) return { name: "B", detail: "760 ≤ Vs30 < 1500 m/s" };
        if (vs30 >= 360) return { name: "C", detail: "360 ≤ Vs30 < 760 m/s" };
        if (vs30 >= 180) return { name: "D", detail: "180 ≤ Vs30 < 360 m/s" };
        return { name: "E", detail: "Vs30 < 180 m/s" };
      }

      function update() {
        const data = new FormData(form);
        const index = categoryIndex(n(data, "floors"), n(data, "columnLoad"));
        const category = categories[index];
        const foundation = foundationDepth(data);
        const requiredDepth = Math.max(category.depth, foundation.value);
        const soilProfile = profile(n(data, "vs30"), data.has("specialSoil"));
        const fs = s(data, "loadCase") === "normal" ? 3 : s(data, "loadCase") === "maximum" ? 2.5 : 1.5;
        const qApplied = n(data, "serviceLoad") / n(data, "area");
        const qAllowable = n(data, "qunet") / fs + n(data, "qob");
        const utilization = qApplied / qAllowable;
        const settlementOk = n(data, "settlement") <= n(data, "settlementLimit");
        const items = [
          { ok: n(data, "actualBorings") >= category.borings, title: "Numero de sondeos", detail: `${n(data, "actualBorings")} ejecutados / ${category.borings} mínimos.`, ref: "NEC-SE-GC 3.5.2, tabla 2" },
          { ok: n(data, "actualDepth") >= requiredDepth, title: "Profundidad de exploracion", detail: `${n(data, "actualDepth").toFixed(1)} m alcanzados / ${requiredDepth.toFixed(1)} m requeridos.`, ref: "NEC-SE-GC 3.5.3, tablas 2 y 3" },
          { ok: utilization <= 1, title: "Capacidad portante", detail: `${(utilization * 100).toFixed(1)}% de utilización con FS ${fs.toFixed(1)}.`, ref: "NEC-SE-GC 6.2 y 7.2" },
          { ok: settlementOk, title: "Estado limite de servicio", detail: `${n(data, "settlement").toFixed(1)} mm estimados / ${n(data, "settlementLimit").toFixed(1)} mm tolerables.`, ref: "NEC-SE-GC 6.3 y 7.3" },
          { ok: !data.has("specialSoil"), warn: data.has("specialSoil"), title: "Respuesta de sitio", detail: data.has("specialSoil") ? "El perfil F requiere evaluacion especifica y no admite coeficientes tabulados." : `Clasificacion preliminar ${soilProfile.name} por Vs30.`, ref: "NEC-SE-DS 3.2.1 y 10.5.4" },
          { ok: data.has("groundwater"), title: "Agua subterranea", detail: data.has("groundwater") ? "Nivel freatico investigado." : "Debe establecerse su posicion y variacion esperada.", ref: "NEC-SE-GC 3.2 y 3.3" },
          { ok: data.has("liquefaction"), title: "Licuacion y degradacion", detail: data.has("liquefaction") ? "Evaluacion declarada en el estudio." : "Confirme susceptibilidad a licuacion y pérdida de resistencia.", ref: "NEC-SE-GC / NEC-SE-DS perfil F1" },
          { ok: data.has("neighbors"), title: "Construcciones vecinas", detail: data.has("neighbors") ? "Efectos sobre predios vecinos evaluados." : "Revisar asentamientos, excavacion y descenso del nivel freatico sobre vecinos.", ref: "NEC-SE-GC 3.3" },
        ];
        const reportKeys = ["locationPlans", "logs", "profile", "calculations", "construction"];
        const reportComplete = reportKeys.filter((key) => data.has(key)).length;
        items.push({ ok: reportComplete === reportKeys.length, title: "Informe geotecnico", detail: `${reportComplete} de ${reportKeys.length} grupos documentales declarados.`, ref: "NEC-SE-GC 3.3" });

        set("#soil-category", category.name);
        set("#category-basis", `${n(data, "floors")} niveles · ${n(data, "columnLoad")} kN/columna`);
        set("#required-borings", String(category.borings));
        set("#required-depth", `${requiredDepth.toFixed(1)} m`);
        set("#depth-basis", requiredDepth === category.depth ? `Gobierna categoria ${category.name}` : foundation.label);
        set("#soil-profile", soilProfile.name);
        set("#profile-basis", soilProfile.detail);
        set("#applied-pressure", `${qApplied.toFixed(1)} kPa`);
        set("#allowable-capacity", `${qAllowable.toFixed(1)} kPa`);
        set("#capacity-use", `${(utilization * 100).toFixed(1)}%`);
        set("#capacity-note", utilization <= 1 ? "La presión aplicada no supera la capacidad admisible calculada." : "La presión aplicada supera la capacidad admisible; revise geometría o solución de cimentación.");
        const bar = document.querySelector<HTMLElement>("#capacity-bar")!;
        bar.style.width = `${Math.min(utilization * 100, 100)}%`;
        bar.className = utilization > 1 ? "over" : utilization > .8 ? "near" : "";
        const failed = items.filter((item) => !item.ok && !item.warn).length;
        const warned = items.filter((item) => item.warn).length;
        set("#soil-summary", `${items.length - failed - warned} conformes · ${failed} observaciones · ${warned} especiales`);
        const status = document.querySelector("#soil-status")!;
        status.textContent = failed ? "Requiere ajustes" : warned ? "Estudio especifico" : "Pre-revision conforme";
        status.className = `status-pill ${failed ? "error" : warned ? "warning" : ""}`;
        document.querySelector("#soil-findings")!.innerHTML = items.map((item) => {
          const state = item.ok ? "pass" : item.warn ? "warn" : "fail";
          const mark = state === "pass" ? "✓" : state === "warn" ? "?" : "!";
          return `<article class="finding ${state}"><span class="finding-mark">${mark}</span><div><strong>${item.title}</strong><p>${item.detail}</p><small>${item.ref}</small></div></article>`;
        }).join("");
        syncActiveBoring();
        saveModule("geotech", Object.fromEntries(data) as Record<string, unknown>, { category: category.name, requiredBorings: category.borings, requiredDepth, profile: soilProfile.name, appliedPressure: qApplied, allowableCapacity: qAllowable, utilization, settlementOk, boreholeCount: boreholes.length, validationErrors: boreholes.flatMap(validateBorehole).length });
      }

      form.addEventListener("submit", (event) => { event.preventDefault(); update(); });
      form.addEventListener("input", update);
      form.addEventListener("change", update);
      layerRows.addEventListener("input", syncLayers);
      layerRows.addEventListener("change", syncLayers);
      layerRows.addEventListener("click", (event) => { const button = (event.target as Element).closest(".remove-layer"); if (!button) return; const row = button.closest<HTMLTableRowElement>("tr[data-index]")!; if (layers.length > 1) layers.splice(Number(row.dataset.index), 1); renderLayers(); });
      document.querySelector("#add-layer")!.addEventListener("click", () => { const from = layers.at(-1)?.to ?? 0; layers.push({ from, to: from + 1.5, description: "Nuevo estrato", uscs: "CL", sample: `M-${String(layers.length + 1).padStart(2,"0")}`, n1: 0, n2: 0, n3: 0, moisture: 0, gamma: 18, cohesion: 0, friction: 28, permeability: 1e-7, modulus: 10 }); renderLayers(); });
      document.querySelector("#save-boring")!.addEventListener("click", () => { syncActiveBoring(); const payload = { schema: "codenormative.geotech.v2", form: Object.fromEntries(new FormData(form)), boreholes, activeBoring }; localStorage.setItem("codenormative-boring", JSON.stringify(payload)); renderBoreholeProject(); const button = document.querySelector<HTMLButtonElement>("#save-boring")!; button.textContent = "Proyecto guardado"; setTimeout(() => button.textContent = "Guardar", 1600); });
      document.querySelector("#new-boring")!.addEventListener("click", () => { syncActiveBoring(); const next=boreholes.length+1; const copy=structuredClone(boreholes[activeBoring]); copy.id=`S-${String(next).padStart(2,"0")}`; copy.x+=10; copy.y+=10; boreholes.push(copy); loadBoring(boreholes.length-1); });
      document.querySelector("#boring-list")!.addEventListener("click",(event)=>{const button=(event.target as Element).closest<HTMLElement>("[data-boring]");if(button)loadBoring(Number(button.dataset.boring));});
      document.querySelector("#pdf-boring")!.addEventListener("click", generatePdf);
      document.querySelector("#export-geo5")!.addEventListener("click", () => { const data=new FormData(form); const header=["borehole_id","x","y","elevation_m","depth_from_m","depth_to_m","description","uscs","sample","spt_n1","spt_n2","spt_n3","spt_n","moisture_pct","unit_weight_kn_m3","cohesion_kpa","friction_deg","permeability_m_s","young_modulus_mpa"]; const rows=layers.map((layer)=>[data.get("boringId"),data.get("coordE"),data.get("coordN"),data.get("elevation"),layer.from,layer.to,layer.description,layer.uscs,layer.sample,layer.n1,layer.n2,layer.n3,layer.n2+layer.n3,layer.moisture,layer.gamma,layer.cohesion,layer.friction,layer.permeability,layer.modulus].map(csvCell).join(",")); downloadFile(`geo5-${data.get("boringId")}.csv`,[header.join(","),...rows].join("\r\n"),"text/csv;charset=utf-8"); });
      document.querySelector("#export-geostudio")!.addEventListener("click", () => { const header="depth_m,spt_n,moisture_pct,unit_weight_kn_m3,cohesion_kpa,friction_deg,permeability_m_s,young_modulus_mpa"; const rows=layers.flatMap((layer)=>[[layer.from,layer.n2+layer.n3,layer.moisture,layer.gamma,layer.cohesion,layer.friction,layer.permeability,layer.modulus],[layer.to,layer.n2+layer.n3,layer.moisture,layer.gamma,layer.cohesion,layer.friction,layer.permeability,layer.modulus]]).map((row)=>row.join(",")); downloadFile("geostudio-material-functions.csv",[header,...rows].join("\r\n"),"text/csv;charset=utf-8"); });
      document.querySelector("#export-dxf")!.addEventListener("click", () => { const entities=layers.map((layer,index)=>{const y1=-layer.from,y2=-layer.to;return `0\nLWPOLYLINE\n8\nSTRATA_${index+1}\n90\n4\n70\n1\n10\n0\n20\n${y1}\n10\n5\n20\n${y1}\n10\n5\n20\n${y2}\n10\n0\n20\n${y2}\n0\nTEXT\n8\nLABELS\n10\n5.3\n20\n${(y1+y2)/2}\n40\n0.2\n1\n${layer.uscs} - ${layer.description.replace(/[^\x20-\x7E]/g,"")}`;}).join("\n"); downloadFile("perfil-estratigrafico.dxf",`0\nSECTION\n2\nHEADER\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n${entities}\n0\nENDSEC\n0\nEOF\n`,"application/dxf"); });
      document.querySelector("#export-project")!.addEventListener("click", () => downloadFile("proyecto-geotecnico.json",JSON.stringify(projectPayload(),null,2),"application/json"));
      document.querySelector<HTMLInputElement>("#import-project")!.addEventListener("change", async (event) => { const file=(event.target as HTMLInputElement).files?.[0]; if(!file)return; try{const payload=JSON.parse(await file.text()); if(payload.schema!=="codenormative.geotech.v1"||!Array.isArray(payload.layers))throw new Error("Formato incompatible"); Object.entries(payload.form||{}).forEach(([key,value])=>{const field=form.elements.namedItem(key) as HTMLInputElement|HTMLSelectElement|null;if(!field)return;if(field.type==="checkbox")(field as HTMLInputElement).checked=value==="on";else field.value=String(value);}); layers=payload.layers;renderLayers();update();}catch{alert("No se pudo importar el proyecto. Verifique que sea un respaldo CodeNormative válido.");} });
      const saved = localStorage.getItem("codenormative-boring");
      if (saved) { try { const payload = JSON.parse(saved); Object.entries(payload.form || {}).forEach(([key, value]) => { const field = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null; if (!field) return; if (field.type === "checkbox") (field as HTMLInputElement).checked = value === "on"; else field.value = String(value); }); if (Array.isArray(payload.boreholes) && payload.boreholes.length) { boreholes=payload.boreholes; activeBoring=Math.min(Number(payload.activeBoring)||0,boreholes.length-1); layers=structuredClone(boreholes[activeBoring].layers); } else if (Array.isArray(payload.layers) && payload.layers.length) layers = payload.layers; } catch {} }
      if (!boreholes.length) boreholes=[captureBoring()];
      renderLayers();
      renderBoreholeProject();
      update();
    </script>
  </body>
</html>
