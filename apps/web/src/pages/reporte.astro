---
import "../styles/global.css";
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>CodeNormative | Reporte integral</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Chango&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/></head>
<body><main class="app-shell"><aside class="sidebar review-sidebar"><div class="brand"><span class="brand-mark">C/N</span><div><p>CodeNormative</p><span>Expediente tecnico</span></div></div><nav class="module-nav"><a href="/"><span>01</span> Espectro NEC</a><a href="/revision-estructural"><span>02</span> Revision estructural</a><a href="/estudio-suelos"><span>03</span> Estudio de suelos</a><a href="/reporte" class="active"><span>04</span> Reporte integral</a></nav><p class="sidebar-foot">El reporte conserva entradas, resultados, fecha y referencias. Debe revisarse y firmarse por profesionales responsables.</p></aside>
<section class="workspace report-workspace"><header class="topbar"><div><p class="eyebrow">Expediente coordinado</p><h1>Reporte integral</h1></div><button id="download-report">Descargar PDF tecnico</button></header><p class="review-notice">Documento de pre-revision. Las conclusiones asistidas nunca sustituyen el criterio, firma ni responsabilidad profesional.</p><section id="report-modules" class="report-modules"></section><section class="result-window"><div class="window-bar"><span class="window-index">AI</span><div><h2>Interpretacion asistida preparada para API</h2><p>Contrato seguro para un futuro modelo de lenguaje</p></div></div><div class="assistant-contract"><p>El motor enviara exclusivamente resultados estructurados, referencias y banderas de calidad. La respuesta se limita a explicar hallazgos, contradicciones y datos faltantes; no modifica capacidades, asentamientos ni dimensiones.</p><code>POST /api/v1/interpretations/foundation</code><ul><li>Salida con evidencia por afirmacion y nivel de confianza.</li><li>Bloqueo de recomendaciones cuando falten sondeos, laboratorio o revision profesional.</li><li>Trazabilidad de version normativa y modelo utilizado.</li></ul></div></section></section></main>
<script>
import { jsPDF } from "jspdf";
import { readProject } from "../lib/project-store";
const project=readProject();
const definitions=[{key:"spectrum",title:"Espectro de diseno",ref:"NEC-SE-DS",fields:[["z","Factor Z"],["fa","Fa"],["fd","Fd"],["fs","Fs"],["t0","T0 (s)"],["tc","Tc (s)"],["peakSa","Sa maxima (g)"]]},{key:"structural",title:"Comprobaciones estructurales",ref:"NEC-SE-DS / NEC-SE-RE",fields:[["period","Periodo (s)"],["baseShear","Cortante basal (kN)"],["drift","Deriva (%)"],["category","Categoria"],["failed","No conformidades"]]},{key:"geotech",title:"Estudio geotecnico",ref:"NEC-SE-GC / Terzaghi",fields:[["category","Categoria"],["boreholeCount","Sondeos modelados"],["requiredBorings","Sondeos requeridos"],["requiredDepth","Profundidad requerida (m)"],["allowableCapacity","q admisible (kPa)"],["utilization","Utilizacion"],["validationErrors","Errores de consistencia"]]}] as const;
const fmt=(value:unknown)=>typeof value==="number"?(Math.abs(value)<10?value.toFixed(3):value.toFixed(1)):String(value??"-");
const modules=document.querySelector("#report-modules")!;
modules.innerHTML=definitions.map((definition)=>{const snapshot=project[definition.key];if(!snapshot)return `<section class="result-window report-card missing"><div class="window-bar"><div><h2>${definition.title}</h2><p>${definition.ref}</p></div></div><p>Modulo pendiente: abra y calcule este modulo para incorporarlo.</p></section>`;return `<section class="result-window report-card"><div class="window-bar"><div><h2>${definition.title}</h2><p>${definition.ref} · actualizado ${new Date(snapshot.updatedAt).toLocaleString("es-EC")}</p></div><span class="status-pill">Incluido</span></div><div class="report-values">${definition.fields.map(([key,label])=>`<article><span>${label}</span><strong>${fmt(snapshot.result[key])}</strong></article>`).join("")}</div></section>`}).join("");
document.querySelector("#download-report")!.addEventListener("click",()=>{const doc=new jsPDF({unit:"mm",format:"a4"});const width=doc.internal.pageSize.getWidth();doc.setFillColor(40,58,47);doc.rect(0,0,width,24,"F");doc.setTextColor(255);doc.setFont("helvetica","bold");doc.setFontSize(18);doc.text("CODENORMATIVE",14,11);doc.setFontSize(9);doc.text("EXPEDIENTE TECNICO INTEGRAL",14,18);let y=34;definitions.forEach((definition)=>{const snapshot=project[definition.key];doc.setTextColor(35);doc.setFont("helvetica","bold");doc.setFontSize(13);doc.text(definition.title,14,y);doc.setFontSize(7);doc.setTextColor(95);doc.text(definition.ref,14,y+5);y+=11;if(!snapshot){doc.setFont("helvetica","normal");doc.text("MODULO PENDIENTE",18,y);y+=10;return;}definition.fields.forEach(([key,label])=>{doc.setFont("helvetica","normal");doc.setTextColor(90);doc.text(label,18,y);doc.setFont("helvetica","bold");doc.setTextColor(30);doc.text(fmt(snapshot.result[key]),105,y);y+=6;});y+=6;if(y>260){doc.addPage();y=20;}});doc.setFontSize(7);doc.setTextColor(100);doc.text("Pre-revision automatizada. Requiere verificacion y firma de los profesionales responsables.",14,286);doc.save("codenormative-reporte-integral.pdf");});
</script></body></html>
